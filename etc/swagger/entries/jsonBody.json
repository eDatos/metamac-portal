                        ]
                    }
                },
                {
                    "dimensionId": "TIME_PERIOD",
                    "labelVisualisationMode": "LABEL",
                    "position": 21,
                    /* Si la dimensión es temporal, se le podrán aplicar los siguientes filtros */
                    "dimensionFilters": {
                        "range": { /* range incluirá el listado de valores entre start y end, ambos incluidos */
                            "start": "2010-M01",
                            "end": "2011-M02" /* Si alguno de los filtros no se incluye, se considerará un rango abierto */
                        },
                        "last": 4, /* range incluirá los últimos n valores de entre los disponibles */
