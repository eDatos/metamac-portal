<?xml version="1.0" encoding="UTF-8"?>
<web-app id="metamac-portal-web" version="2.5"
	xmlns="http://java.sun.com/xml/ns/javaee" xmlns:web="http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">

	<!-- ********************* SPRING INTEGRATION ******************** -->
	<context-param>
		<param-name>contextConfigLocation</param-name>
		<param-value>/WEB-INF/config/spring/applicationContext.xml </param-value>
	</context-param>

	<listener>
		<listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
	</listener>

	<listener>
		<listener-class>org.siemac.metamac.portal.web.ApplicationStartup</listener-class>
	</listener>
    
    <servlet>
        <servlet-name>operations</servlet-name>
        <jsp-file>/jsp/visualizer/operations.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>operations</servlet-name>
        <url-pattern>/visualizer/operations.html</url-pattern>
    </servlet-mapping>
    
	<servlet>
		<servlet-name>data</servlet-name>
		<jsp-file>/jsp/visualizer/data.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>data</servlet-name>
        <!-- There is no /visualizer/*/data.html for url patterns -->
		<url-pattern>/visualizer/data.html</url-pattern>    
        <!-- custom -->    
        <url-pattern>/visualizer/custom/data.html</url-pattern>
        <!-- istac -->
        <url-pattern>/visualizer/agricultura/data.html</url-pattern>
        <url-pattern>/visualizer/medioambiente/data.html</url-pattern>
        <url-pattern>/visualizer/turismo/data.html</url-pattern>
        <url-pattern>/visualizer/funcion-publica/data.html</url-pattern>        
        <!-- ibestat -->
        <url-pattern>/visualizer/iqua/data.html</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>collection</servlet-name>
		<jsp-file>/jsp/visualizer/collection.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>collection</servlet-name>
		<url-pattern>/visualizer/collection.html</url-pattern>
        <!-- custom -->
        <url-pattern>/visualizer/custom/collection.html</url-pattern>
        <!-- istac -->        
        <url-pattern>/visualizer/agricultura/collection.html</url-pattern>
        <url-pattern>/visualizer/medioambiente/collection.html</url-pattern>
        <url-pattern>/visualizer/turismo/collection.html</url-pattern>
        <url-pattern>/visualizer/funcion-publica/collection.html</url-pattern>
        <!-- ibestat -->
        <url-pattern>/visualizer/iqua/collection.html</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>widget</servlet-name>
		<jsp-file>/jsp/widget.jsp</jsp-file>
	</servlet>
	<servlet-mapping>
		<servlet-name>widget</servlet-name>
		<url-pattern>/widget.html</url-pattern>
	</servlet-mapping>
    
    <servlet>
        <servlet-name>widget-js</servlet-name>
        <jsp-file>/js/widget.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>widget-js</servlet-name>
        <url-pattern>/js/widget.js</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>403</servlet-name>
        <jsp-file>/jsp/visualizer/403.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>403</servlet-name>
        <url-pattern>/error/403.html</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>widget-login-required</servlet-name>
        <jsp-file>/jsp/visualizer/widget-login-required.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>widget-login-required</servlet-name>
        <url-pattern>/error/widget-login-required.html</url-pattern>
    </servlet-mapping>

    <!-- CORS -->
    <filter>
        <filter-name>CORSFilter</filter-name>
        <filter-class>org.siemac.metamac.core.common.filter.CORSFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>CORSFilter</filter-name>
        <url-pattern>/apis/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>CookieRewritePathFilter</filter-name>
        <filter-class>org.siemac.metamac.portal.web.filter.CookieRewritePathFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CookieRewritePathFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Encoding -->
   <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>org.siemac.metamac.core.common.filter.URIEncodingFilter</filter-class>
        <init-param>
            <param-name>encodings</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>

    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    

	<error-page>
		<exception-type>404</exception-type>
		<location>/error.html</location>
	</error-page>
	<error-page>
		<exception-type>java.lang.Exception</exception-type>
		<location>/error.html</location>
	</error-page>
	<welcome-file-list>
		<welcome-file>jsp/visualizer/operations.jsp</welcome-file>
	</welcome-file-list>
</web-app>
