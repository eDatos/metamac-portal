Application Portal {
    basePackage=org.siemac.metamac.portal

	Module core {
		basePackage=org.siemac.metamac.portal.core
		
		// ----------------------------------------------------------------
		// 							SERVICES
		// ----------------------------------------------------------------  
		
		Service PermalinksService {
			> @PermalinkRepository
			
			"Creates new permalink, generating the permalink code"
			@Permalink createPermalink(@Permalink permalink) throws MetamacException;
			"Retrieves permalink by code. Throws exception if permalink does not exist"
			@Permalink retrievePermalinkByCode(String code) throws MetamacException;
    		"Finds permalinks by criteria"
    		PagedResult<@Permalink> findPermalinksByCondition(List<ConditionalCriteria> conditions, PagingParameter pagingParameter)  throws MetamacException;
		}
		
		Service ExportService {
			exportDatasetToExcel(DatasetBase dataset, DatasetSelection datasetSelection, String lang, OutputStream resultOutputStream) throws MetamacException;
			exportDatasetToTsv(DatasetBase dataset, DatasetSelection datasetSelection, String lang, OutputStream resultObservationsOutputStream, OutputStream resultAttributesOutputStream) throws MetamacException;
			exportDatasetToCsvCommaSeparated(DatasetBase dataset, DatasetSelection datasetSelection, String lang, OutputStream resultObservationsOutputStream, OutputStream resultAttributesOutputStream) throws MetamacException;
			exportDatasetToCsvSemicolonSeparated(DatasetBase dataset, DatasetSelection datasetSelection, String lang, OutputStream resultObservationsOutputStream, OutputStream resultAttributesOutputStream) throws MetamacException;
			exportDatasetToPx(DatasetBase dataset, DatasetSelection datasetSelection, String lang, OutputStream resultOutputStream) throws MetamacException;

			exportQueryToExcel(QueryBase query, DatasetBase relatedDataset, DatasetSelection datasetSelection, String lang, OutputStream resultOutputStream) throws MetamacException;
			exportQueryToTsv(QueryBase query, DatasetSelection datasetSelection, String lang, OutputStream resultObservationsOutputStream, OutputStream resultAttributesOutputStream) throws MetamacException;
            exportQueryToCsvCommaSeparated(QueryBase query, DatasetSelection datasetSelection, String lang, OutputStream resultObservationsOutputStream, OutputStream resultAttributesOutputStream) throws MetamacException;
            exportQueryToCsvSemicolonSeparated(QueryBase query, DatasetSelection datasetSelection, String lang, OutputStream resultObservationsOutputStream, OutputStream resultAttributesOutputStream) throws MetamacException;
            exportQueryToPx(QueryBase query, DatasetBase relatedDataset, DatasetSelection datasetSelection, String lang, OutputStream resultOutputStream) throws MetamacException;
        
            exportResourceToPlainText(PlainTextTypeEnum plainTextTypeEnum, ResourceAccess resourceAccess, OutputStream resultObservationsOutputStream, OutputStream resultAttributesOutputStream) throws MetamacException ;
            exportResourceToPlainTextWithoutAttributes(PlainTextTypeEnum plainTextTypeEnum, ResourceAccess resourceAccess, OutputStream resultObservationsOutputStream) throws MetamacException;
			
			exportSvgToImage(String svg, Float width, String mimeType, OutputStream resultOutputStream) throws MetamacException;
		}
		
		// ----------------------------------------------------------------
		// 							ENTITIES
		// ---------------------------------------------------------------- 
		
		Entity Permalink {
			databaseTable="TB_PERMALINKS"
			hint="idSequence=PERMALINK"
			
			String code not nullable;
       		Clob content not nullable;
			
			Repository PermalinkRepository {
				@Permalink findByCode(String code);
				findByQuery(String query, Map<String, Object> parameters, int maxResult);
		   		findByCondition(PagingParameter pagingParameter);
		   		save;
			}
		}
    }
}